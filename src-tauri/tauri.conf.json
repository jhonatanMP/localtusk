{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalTusk",
  "version": "0.11.0",
  "identifier": "dev.localtusk.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalTusk",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Ambientes PHP locais sem Docker",
    "longDescription": "Gerencia projetos PHP locais com Caddy, PHP-FPM, MySQL ou PostgreSQL e Redis nativos, sem Docker.",
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "recommends": [
          "libaio1t64 | libaio1",
          "libnuma1",
          "build-essential"
        ]
      },
      "rpm": {
        "recommends": [
          "libaio",
          "numactl-libs",
          "make",
          "gcc"
        ]
      }
    }
  }
}
